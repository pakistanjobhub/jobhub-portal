# Data source: "seed" (default, no credentials needed) or "supabase"
DATA_SOURCE=seed

# Supabase — required only when DATA_SOURCE=supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (Phase 1 dev-only simple check — see README).
# Pick a long random value. Never commit a real value.
ADMIN_KEY=

# Public site URL used for canonical tags + sitemap. Update on deploy.
NEXT_PUBLIC_SITE_URL=https://pakistanjobhub.github.io/Pakistan-job-hub
